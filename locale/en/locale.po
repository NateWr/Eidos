msgid "plugins.themes.eidos.option.header.label"
msgstr "Header"

msgid "plugins.themes.eidos.option.header.description"
msgstr "Choose the layout of the logo and navigation menus in the header of your site. The default layouts work for most sites. Only use the One Line option if you have a small number of items in your navigation menu."

msgid "plugins.themes.eidos.option.header.default"
msgstr "Default"

msgid "plugins.themes.eidos.option.header.default-boxed"
msgstr "Boxed Layout"

msgid "plugins.themes.eidos.option.header.line"
msgstr "One Line (logo and navigation menu on one line)"

msgid "plugins.themes.eidos.option.tagline.label"
msgstr "Tagline"

msgid "plugins.themes.eidos.option.tagline.description"
msgstr "A short description, motto or title to display beside the journal's logo. This will not be displayed if no logo is uploaded."

msgid "plugins.themes.eidos.option.homepageImagePosition.label"
msgstr "Homepage Image Position"

msgid "plugins.themes.eidos.option.homepageImagePosition.description"
msgstr "Choose how to display the Homepage Image on the header of your website. The Homepage Image can be uploaded in the <a href='#appearance/appearance-setup'>Appearance > Setup</a> settings."

msgid "plugins.themes.eidos.option.homepageImagePosition.above"
msgstr "Above Header"

msgid "plugins.themes.eidos.option.homepageImagePosition.behind"
msgstr "Behind Header"

msgid "plugins.themes.eidos.option.homepageImagePosition.below"
msgstr "Below Header"

msgid "plugins.themes.eidos.option.homepageImagePosition.none"
msgstr "Don't show the homepage image in the header"

msgid "plugins.themes.eidos.option.siteWidth.label"
msgstr "Site Width"

msgid "plugins.themes.eidos.option.siteWidth.description"
msgstr "Choose how your site should appear when viewed on on very large screens. If you use the Homepage Image in your header, you may want to choose Fixed Width to prevent the image from becoming too large."

msgid "plugins.themes.eidos.option.siteWidth.full"
msgstr "Full Width - The header and footer will extend the full width of the screen."

msgid "plugins.themes.eidos.option.siteWidth.fixed"
msgstr "Fixed Width - On very large screens, the header and footer will not be wider than then page content."

msgid "plugins.themes.eidos.option.font.label"
msgstr "Base Font"

msgid "plugins.themes.eidos.option.font.description"
msgstr "Select the font to use for the main body text, such as paragraphs and long blocks of text."

msgid "plugins.themes.eidos.option.titlesFont.label"
msgstr "Headings and Titles Font"

msgid "plugins.themes.eidos.option.titlesFont.description"
msgstr "Select the font to use for titles, headings and other large text."

msgid "plugins.themes.eidos.option.actionsFont.label"
msgstr "Buttons, Menus and Forms Font"

msgid "plugins.themes.eidos.option.actionsFont.description"
msgstr "Select the font to use for interactive elements, such as buttons, navigation menus, and forms."

msgid "plugins.themes.eidos.option.highlightArticleMetadata.label"
msgstr "Article Highlight Metadata"

msgid "plugins.themes.eidos.option.highlightArticleMetadata.description"
msgstr "Select the article metadata that you want to show at the top of the article landing page."

msgid "plugins.themes.eidos.option.sidebarArticleMetadata.label"
msgstr "Article Sidebar Metadata"

msgid "plugins.themes.eidos.option.sidebarArticleMetadata.description"
msgstr "Select the article metadata that you want to show in the sidebar on the article landing page."

msgid "plugins.themes.eidos.option.issueArchives.label"
msgstr "Issue Archives"

msgid "plugins.themes.eidos.option.issueArchives.description"
msgstr "Select how to display the list of published issues in the archive."

msgid "plugins.themes.eidos.option.issueArchives.default"
msgstr "Show detailed issue summaries with the cover image, volume, number, title, and description. (Default)"

msgid "plugins.themes.eidos.option.issueArchives.covers"
msgstr "Show a gallery of issue cover images."

msgid "plugins.themes.eidos.option.issueArchives.list"
msgstr "Show short issue summaries with the volume, number, and title. (Recommended for large back catalogs.)"

msgid "plugins.themes.eidos.option.homepageBlocks.label"
msgstr "Homepage Blocks"

msgid "plugins.themes.eidos.option.homepageBlocks.description"
msgstr "Select which blocks to show on your homepage."

msgid "plugins.themes.eidos.option.homepageBlocks.how-to-submit"
msgstr "How to Submit"

msgid "plugins.themes.eidos.option.homepageBlocks.about"
msgstr "About the Journal with Homepage Menu"

msgid "plugins.themes.eidos.option.howToSubmitTitle.label"
msgstr "How to Submit - Title"

msgid "plugins.themes.eidos.option.howToSubmitTitle.description"
msgstr "Change the title for the How to Submit block on the homepage."

msgid "plugins.themes.eidos.option.howToSubmitText.label"
msgstr "How to Submit - Text"

msgid "plugins.themes.eidos.option.howToSubmitText.description"
msgstr "Change the short prompt about making a submission to this journal."

msgid "plugins.themes.eidos.option.howToSubmitText.default"
msgstr "Read our author guidelines and learn how to submit to {$journalName}."

msgid "plugins.themes.eidos.option.howToSubmitAction.label"
msgstr "How to Submit - Button"

msgid "plugins.themes.eidos.option.howToSubmitAction.description"
msgstr "Change the text on the button to view the submissions page."

msgid "plugins.themes.eidos.option.howToSubmitAction.default"
msgstr "How to Submit"
