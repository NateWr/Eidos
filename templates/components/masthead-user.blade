@props([
    'name',
    'orcid' => '',
    'affiliation' => '',
    'dateStart' => '',
    'dateEnd' => '',
])

<div class="masthead-user">
    <span class="masthead-user-name">
        {{ $name }}
        @if ($orcid)
            <span class="masthead-user-orcid">
                <a
                    href="{{ $orcid }}"
                    target="_blank"
                    aria-label="{{ __('common.editorialHistory.page.orcidLink') }}"
                    name="{{ $name }}"
                >
                    {!! $orcidIcon !!}
                </a>
            </span>
        @endif
        @if(!empty($dateStart))
            @php
                $localeKey = !$dateEnd
                    ? 'plugins.themes.eidos.fromUntilCurrent'
                    : 'common.fromUntil';
            @endphp
            <span class="masthead-user-date-start">
                {!!
                    __('common.inParenthesis', [
                        'text' => __($localeKey, [
                            'from' => $dateStart,
                            'until' => '',
                        ])
                    ])
                !!}
            </span>
        @endif
    </span>
    @if(!empty($affiliation))
        <span class="masthead-user-affiliation">
            {{ $affiliation }}
        </span>
    @endif
</div>