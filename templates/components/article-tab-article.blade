<div class="article-tab-article">

    @if($publication->getLocalizedData('abstract'))
        <section class="article-section article-section-abstract">
            <h2 class="article-section-title">
                {{ __('article.abstract') }}
            </h2>
            <div class="article-section-content">
                {!! ViewHelper::sanitizeHtml($publication->getLocalizedData('abstract')) !!}
            </div>
        </section>
    @endif

    @if($publication->getLocalizedData('plainLanguageSummary'))
        <section class="article-section article-section-plain-language-summary">
            <h2 class="article-section-title">
                {{ __('submission.plainLanguageSummary') }}
            </h2>
            <div class="article-section-content">
                {!! ViewHelper::sanitizeHtml($publication->getLocalizedData('plainLanguageSummary')) !!}
            </div>
        </section>
    @endif

    @if(count($parsedCitations) || (string) $publication->getData('citationsRaw'))
        <section class="article-section article-section-references">
            <h2 class="article-section-title">
                {{ __('submission.citations') }}
            </h2>
            <div class="article-section-content">
                @if(count($parsedCitations))
                    @foreach($parsedCitations as $parsedCitation)
                        <p>
                            {!! ViewHelper::sanitizeHtml($parsedCitation->getRawCitationWithLinks()) !!}
                            @callHook(['name' => 'Templates::Article::Details::Reference', 'citation' => $parsedCitation])
                        </p>
                    @endforeach
                @else
                    {{ nl2br($publication->getData('citationsRaw')) }}
                @endif
            </div>
        </section>
    @endif

    @php
        $hasAuthorDetails = false;
        foreach ($publication->getData('authors') as $author) {
            if (
                $author->getLocalizedData('biography')
                || count($author->getAffiliations())
                || count($author->getLocalizedContributorRoleNames())
                || count($author->getCreditRoles())
            ) {
                $hasAuthorDetails = true;
                break;
            }
        }
    @endphp
    @if($hasAuthorDetails)
        <section class="article-section article-section-author-details">
            <h2 class="article-section-title">
                {{ __('plugins.themes.eidos.authorDetails') }}
            </h2>
            <ul class="article-section-content">
                @foreach ($publication->getData('authors') as $author)
                    <li>
                        @include('components/author-detail', ['author' => $author])
                    </li>
                @endforeach
            </ul>
        </section>
    @endif;
</div>