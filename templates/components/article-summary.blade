{{--
 * Article summary
 *
 * Used in issue tables of content, search results, and when browsing
 * by category. Accepts a number of params to modify behavior.
 *
 * @see APP\plugins\themes\eidos\classes\components\ArticleSummary
 --}}

<div
    {{
        $attributes->merge([
            'class' => join(' ', ['article-summary', $showCover && $coverImageUrl ? 'article-summary-with-cover' : '']),
        ])
    }}
>
    @if ($coverImageUrl)
        <img
            class="article-summary-cover"
            src="{{ $coverImageUrl }}"
            alt="{{ $coverImageAltText }}"
        >
    @else
        <div>{{-- Empty on purpose --}}</div>
    @endif
    <div class="article-summary-inner">
        <div class="article-summary-content">
            <a
                class="article-summary-link tab-focus"
                href="{{ $url }}"
            >
                <{{ $heading }} class="article-summary-title">
                    {!! ViewHelper::sanitizeHtml($publication->getLocalizedFullTitle(null, 'html')) !!}
                </{{ $heading }}>
                <div class="article-summary-authors">
                    {{ $publication->getAuthorString(true) }}
                </div>
            </a>
            @if ($showAbstract && $publication->getLocalizedData('abstract'))
                <div class="article-summary-abstract html-text">
                    {!! ViewHelper::sanitizeHtml($publication->getLocalizedData('abstract')) !!}
                </div>
            @endif
        </div>

        @if (count($galleys))
            <div class="article-summary-galleys">
                @foreach ($galleys as $galley)
                    <x-eidostheme::galley-link
                        class="article-summary-galley"
                        :galley="$galley"
                        :publication="$publication"
                        :submission="$submission"
                        :context="$context"
                        :hasAccess="true"
                    />
                @endforeach
            </div>
        @endif
    </div>
</div>
